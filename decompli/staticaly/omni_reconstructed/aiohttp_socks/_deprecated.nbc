@FORENSICS 20
# Qualnames in @CONSTS without a matching @OPS block.
# Each block lists adjacent mod_consts + mentions.
# Use this as evidence for the function's probable
# behaviour — do NOT fabricate anything beyond what
# these constants plainly support.

@NO_OPS warnings
  qualname_idx: 0
  adjacent:
    c[0] s 'warnings' <-- qualname
    c[1] s 'warn'
    c[2] s 'SocksConnector is deprecated. Use ProxyConnector instead.'
    c[3] s 'DeprecationWarning'
    c[4] T (3,)
    c[5] T ('stacklevel',)
    c[6] s '_warn_about_connector'

@NO_OPS DeprecationWarning

@CONSTS 1890 mode=full_repr
  0 s '__mro_entries__'
  1 s 'bases'
  2 s '__getitem__'
  3 s '%s argument after * must be an iterable, not %s'
  4 s '%s argument after ** must be a mapping, not %s'
  5 s "%s got multiple values for keyword argument '%s'"
  6 s 'called'
  7 s 'star_arg_dict'
  8 s 'star_arg_list'
  9 s 'kw'
  10 s "'%s' object is not a mapping"
  11 s 'keywords must be strings'
  12 s 'shutil'
  13 s 'BASE_APP_DIR'
  14 s 'db.json'
  15 s 'DATA_DIR'
  16 s 'move'
  17 T ('📦 [Auto-Migration] Đã di chuyển db.json vào thư mục data/',)
  18 s 'v6_config.json'
  19 T ('📦 [Auto-Migration] Đã di chuyển v6_config.json vào thư mục data/',)
  20 s 'license.dat'
  21 s 'config'
  22 s 'configs'
  23 s 'target_license'
  24 s 'copy2'
  25 s '📦 [Auto-Migration] Đã di chuyển bản quyền '
  26 s ' -> data/license.dat'
  27 s 'remove'
  28 s 'settings.json'
  29 s 'target_settings'
  30 s '📦 [Auto-Migration] Đã di chuyển cài đặt '
  31 s ' -> data/settings.json'
  32 T ('custom_subnet.txt', 'custom_interface.txt')
  33 s 'custom_f'
  34 s 'target_f'
  35 s '📦 [Auto-Migration] Đã gom '
  36 s ' -> data/'
  37 s 'is_dir'
  38 s 'os'
  39 s 'rmdir'
  40 s 'Lỗi auto-migration: '
  41 s 'uvicorn.access'
  42 s 'core.pia_api'
  43 s 'levelno'
  44 s 'logging'
  45 s 'ERROR'
  46 s 'main'
  47 s 'INFO'
  48 s 'WARNING'
  49 s 'subprocess'
  50 s 'webbrowser'
  51 s 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe'
  52 s 'C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe'
  53 s 'expandvars'
  54 T ('%LOCALAPPDATA%\\Google\\Chrome\\Application\\chrome.exe',)
  55 s 'C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe'
  56 s 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe'
  57 T ('%LOCALAPPDATA%\\Microsoft\\Edge\\Application\\msedge.exe',)
  58 T ('%LOCALAPPDATA%\\CocCoc\\Browser\\Application\\browser.exe',)
  59 s 'C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe'
  60 s 'Popen'
  61 s '--app='
  62 s '--start-maximized'
  63 s '_browser_proc'
  64 s 'logger'
  65 s 'warning'
  66 s 'Không thể mở qua '
  67 s ': '
  68 s 'startfile'
  69 T (1, True)
  70 T ('new', 'autoraise')
  71 s 'error'
  72 s 'Lỗi mở trình duyệt: '
  73 s 'Mở giao diện dưới dạng Cửa sổ App hoặc Trình duyệt mặc định.'
  74 s 'terminate'
  75 s 'kill'
  76 s 'settings_mgr'
  77 s 'port'
  78 i 8000
  79 s "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*--app=http://localhost:"
  80 s "*' -or $_.CommandLine -like '*--app=http://127.0.0.1:"
  81 s "*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"
  82 s 'run'
  83 s 'powershell'
  84 s '-NoProfile'
  85 s '-Command'
  86 s 'DEVNULL'
  87 s 'CREATE_NO_WINDOW'
  88 T ('stdout', 'stderr', 'creationflags')
  89 s 'Tự động đóng cửa sổ trình duyệt (Chrome/Edge App Mode) khi người dùng thoát app.'
  90 s 'Tự động mở trang Dashboard hoặc License khi server sẵn sàng (bỏ qua khi khởi động ngầm cùng Windows).'
